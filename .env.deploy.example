# ── VPS access ───────────────────────────────────────────────────────────────
#
# Read by scripts/deploy.sh and scripts/vps.sh only, for manual ops from your
# own machine. A normal deploy (a push to `main`) does not need this file.
#
#   cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
#
# Keep these values in your secret store (a password manager, a vault). You can
# render this file from it, or skip the file and export the same variables in
# your shell before running the scripts — they work either way.
#
# This is NOT the application's .env.
#
#   .env         -> rendered on the VPS by the deploy pipeline, env_file'd into
#                   the running container. Application configuration.
#   .env.deploy  -> lives only on your machine. Read by scripts/deploy.sh and
#                   scripts/vps.sh. Referenced by nothing in docker-compose.yml,
#                   and excluded from the Docker build context.
#
# They are separate on purpose. .env is readable by the application process, so
# an SSH key path, the server's address and a GitHub token sitting in it would
# turn any application-level RCE into control of the whole server and the
# GitHub account. Different risk, different file.
#
# GitHub Actions cannot read this file. The same values go in as repository
# secrets under the names in the right-hand comments:
#   Settings -> Secrets and variables -> Actions -> Repository secrets
# Repository *secrets*, not Variables — the workflow reads the `secrets`
# context, which cannot see Variables.

# Public IP of the VPS. 203.0.113.10 is a documentation address: replace it.
# GitHub secret: HOST_IP_ADDRESS
VPS_HOST=203.0.113.10

# SSH user the stack is deployed as. Its account needs Docker access.
# GitHub secret: HOST_ROOT_NAME
VPS_USER=deploy

# SSH port. 22 unless it has been moved.
# GitHub secret: SSH_PORT  (omit the secret entirely to accept the default)
VPS_SSH_PORT=22

# PATH to the private key on this machine — deliberately the path, not the key.
# A key body in a dotenv file gets copy-pasted, committed and leaked; a path
# does not. `~` is expanded by the scripts.
#
# GitHub secret: HOST_SSH_KEY — that one IS the full private key body, header
# and footer included, because Actions has nowhere else to put it. Generate a
# deploy-only key rather than reusing a personal one:
#   ssh-keygen -t ed25519 -C "deploy@semantic-filter-api" -f ~/.ssh/semantic-filter-api-deploy
#   ssh-copy-id -i ~/.ssh/semantic-filter-api-deploy.pub -p 22 deploy@203.0.113.10
VPS_SSH_KEY=~/.ssh/id_ed25519

# Where the stack lives on the server. `$HOME/<repo-name>` by convention, the
# same place the Actions workflow uses. Defaults to /home/<user>/semantic-filter-api
# (/root/semantic-filter-api for root) when left empty.
VPS_APP_DIR=/home/deploy/semantic-filter-api

# GitHub token with read access to this repository. Only needed when your copy
# of the repo is PRIVATE — a public repo is fetched without one. Fine-grained
# token, Contents: Read-only, scoped to this repository alone.
#
# GitHub secret: GH_PAT  (omit it for a public repo)
GH_PAT=

# owner/repo — used to build the clone URL on the server. Use your fork's name.
GH_REPO=rachid-log/semantic-filter-api

# ── Derived, for reference ───────────────────────────────────────────────────
# Container / Traefik router name: semantic-filter-api
# Image name:                      semantic-filter-api:latest  (rollback tag: semantic-filter-api:previous)
# Public hostname:                 https://embed.example.com  (replace with yours)
