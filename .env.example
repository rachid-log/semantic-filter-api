# Copy to .env and fill in. .env is gitignored; this example file is committed
# and is the schema the deploy workflow renders .env from — placeholders only,
# never a real secret.
#
# Any key set as a GitHub Actions *repository secret* of the same name replaces
# the value here at deploy time. Keys left as __REQUIRED__ fail the deploy on
# purpose, so a forgotten secret can never ship as a placeholder.
#
# VPS access credentials do NOT belong in this file — see .env.deploy.example.
# This file is env_file'd into the running container; that one is not.
#
# BUILD TIME vs RUNTIME. Build-time values are baked into the image during
# `docker compose build` and need an ARG in the Dockerfile plus a build.args
# line in docker-compose.yml; changing one is a rebuild, not a restart.
# Secrets go the other way: env_file only, never a build arg, because build
# args stay readable via `docker history`.

# Public origin, no trailing slash. Baked into robots.txt's Host: line at build
# time and reported by /api/health at runtime — the artifact guard compares
# both. MUST stay in sync with the Host(...) rule in docker-compose.yml.
# The image build REFUSES any example.com value, so set your real hostname
# here (or as a SITE_URL repository secret). BUILD TIME.
SITE_URL=https://embed.example.com

# The embedding model baked into the image. bge-small-en-v1.5: 384 dims,
# about 67 MB as ONNX, English, strong on short phrases — chosen for keyword
# dedupe. Changing it re-downloads at build, and re-embedding any stored
# vectors is on you: vectors from different models never mix. BUILD TIME.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Bearer token every POST /embed must present. RUNTIME secret — env_file only,
# asserted present (never printed) by the deploy's artifact guard.
# Generate with: openssl rand -hex 32
EMBED_API_TOKEN=__REQUIRED__

# Hard cap on texts per /embed call; bigger requests get a 413. Protects a
# small (2 GB) server from an accidental 50k-row batch. RUNTIME.
MAX_BATCH=256

# Commit the image was built from, reported by /api/health so the deploy can
# prove the running container is the one it just built. The workflow fills this
# from github.sha; leave it empty locally. BUILD TIME.
GIT_SHA=
